PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/vouch
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173

# Blockchain (defaults below work with `npx hardhat node`)
RPC_URL=http://127.0.0.1:8545
# Well-known Hardhat test account #0. NEVER use this key on a real network.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Public, key-free RPC shown to browsers for independent verification (defaults to RPC_URL when it is localhost)
PUBLIC_RPC_URL=
# Block explorer transaction link prefix, e.g. https://amoy.polygonscan.com/tx/
EXPLORER_TX_URL=
# Optional: overrides server/deployment.json
CONTRACT_ADDRESS=

# Links to files: private/local addresses are blocked unless this is true (development only)
ALLOW_PRIVATE_URLS=false

# Keys the pseudonymous on-chain uploader references (HMAC). Keep it stable and secret; defaults to JWT_SECRET.
REF_SECRET=
